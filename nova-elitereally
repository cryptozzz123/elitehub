-- Auto Buy Weights
MainTab:CreateToggle({
   Name = "Auto Buy Weights",
   CurrentValue = false,
   Flag = "WeightToggle",
   Callback = function(Value)
      _G.AutoWeight = Value
      if Value then
         task.spawn(function()
            while _G.AutoWeight do
               local weights = workspace.Obby:FindFirstChild("Weights")
               if weights then
                  for _, weight in pairs(weights:GetChildren()) do
                     if not _G.AutoWeight then break end
                     local btn = weight:FindFirstChild("Button")
                     local prompt = btn and btn:FindFirstChildOfClass("ProximityPrompt")
                     if prompt then
                        game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = btn.CFrame * CFrame.new(0, 3, 0)
                        task.wait(0.2)
                        fireproximityprompt(prompt)
                     end
                  end
               end
               task.wait(0.5)
            end
         end)
      end
   end,
})

