local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Nova Elite | +1 Strength",
   LoadingTitle = "Nova Elite Systems Online",
   LoadingSubtitle = "by crash",
   ConfigurationSaving = {Enabled = true, FolderName = "NovaElite", FileName = "Config"},
   KeySystem = false
})

--// States
_G.AutoWin = false
_G.AutoBrawl = false
_G.AutoStrength = false
_G.AutoStrengthPad = false
_G.AutoWeight = false
_G.AutoRebirth = false
_G.Godmode = false

local MainTab = Window:CreateTab("Main", nil)
local FarmSection = MainTab:CreateSection("Farming")

-- NEW: Auto Join Brawl
MainTab:CreateToggle({
   Name = "Auto Join Brawl",
   CurrentValue = false,
   Flag = "BrawlToggle",
   Callback = function(Value)
      _G.AutoBrawl = Value
      if Value then
         task.spawn(function()
            while _G.AutoBrawl do
               local remote = game:GetService("ReplicatedStorage"):WaitForChild("Packages"):WaitForChild("Network"):WaitForChild("ClientToServer"):WaitForChild("RemoteEvents"):WaitForChild("JoinBrawl")
               if remote then remote:FireServer() end
               task.wait(0.5) -- 0.5s Interval as requested
            end
         end)
      end
   end,
})

-- Auto Win (Remote 0.6s)
MainTab:CreateToggle({
   Name = "Auto Win (Remote 0.6s)",
   CurrentValue = false,
   Flag = "WinToggle",
   Callback = function(Value)
      _G.AutoWin = Value
      if Value then
         task.spawn(function()
            local remote = game:GetService("ReplicatedStorage"):WaitForChild("Packages"):WaitForChild("Network"):WaitForChild("ClientToServer"):WaitForChild("RemoteFunctions"):WaitForChild("ClaimWinButton")
            while _G.AutoWin do
               remote:InvokeServer(unpack({3}))
               task.wait(0.6)
            end
         end)
      end
   end,
})

-- Auto Strength Pad (Cycle All)
MainTab:CreateToggle({
   Name = "Auto Strength Pad (Cycle All)",
   CurrentValue = false,
   Flag = "PadToggle",
   Callback = function(Value)
      _G.AutoStrengthPad = Value
      if Value then
         task.spawn(function()
            while _G.AutoStrengthPad do
               local pads = workspace.Obby:FindFirstChild("StrengthButtons")
               if pads then
                  for _, pad in pairs(pads:GetChildren()) do
                     if not _G.AutoStrengthPad then break end
                     local btn = pad:FindFirstChild("Button")
                     if btn and game.Players.LocalPlayer.Character then
                        game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = btn.CFrame * CFrame.new(0, 3, 0)
                        task.wait(0.2)
                     end
                  end
               end
               task.wait(0.1)
            end
         end)
      end
   end,
})

local AutomationSection = MainTab:CreateSection("Automation")

-- Auto Strength (Remote)
MainTab:CreateToggle({
   Name = "Auto Strength (Remote Lift)",
   CurrentValue = false,
